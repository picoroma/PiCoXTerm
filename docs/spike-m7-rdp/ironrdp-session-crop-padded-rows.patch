     /// Process a bitmap update, shared between fast-path and slow-path pipelines.
+    /// Le righe decodificate hanno la larghezza `update.width` (spesso arrotondata a multiplo di 4),
+    /// ma il rettangolo di destinazione è più stretto: si tolgono i pixel di riempimento.
+    fn crop_rows(buf: &mut Vec<u8>, bytes_per_pixel: usize, src_width: usize, dst_width: usize) {
+        if dst_width >= src_width || src_width == 0 {
+            return;
+        }
+        let src_row = src_width * bytes_per_pixel;
+        let dst_row = dst_width * bytes_per_pixel;
+        let rows = buf.len() / src_row;
+        let mut out = Vec::with_capacity(rows * dst_row);
+        for r in 0..rows {
+            out.extend_from_slice(&buf[r * src_row..r * src_row + dst_row]);
+        }
+        *buf = out;
+    }
